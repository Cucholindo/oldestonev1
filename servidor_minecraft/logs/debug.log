ayout_data":3565,"github_id":3565},"silXZKbC","rymusov","https://cdn.modrinth.com/user/silXZKbC/4fbfe0110cfe7b706cf0a86f8b328951c62c65e8.jpeg","Wassup, I'm Rymusov and I'm trying to make some stuff for Minecraft (and maybe more content in the future)!\nKnown languages: Ukranian, Russian, English","2024-03-20T20:14:49.394325Z","developer",1779661701632,"success","idle",[33162,33153],"user","[\"user\",\"rymusov\"]",{"dehydratedAt":33149,"state":33165,"queryKey":33260,"queryHash":33262},{"data":33166,"dataUpdateCount":29979,"dataUpdatedAt":33149,"error":3565,"errorUpdateCount":29998,"errorUpdatedAt":29998,"fetchFailureCount":29998,"fetchFailureReason":3565,"fetchMeta":3565,"isInvalidated":439,"status":33159,"fetchStatus":33160},[33167,33197,33224],{"client_side":30119,"server_side":29963,"game_versions":33168,"id":33169,"slug":33170,"project_type":342,"team":33171,"organization":3565,"title":33172,"description":33173,"body":33174,"body_url":3565,"published":33175,"updated":33176,"approved":33177,"queued":33178,"status":29951,"requested_status":29951,"moderator_message":3565,"license":33179,"downloads":33180,"followers":30896,"categories":33181,"additional_categories":33182,"loaders":33183,"versions":33184,"icon_url":33189,"issues_url":33190,"source_url":3565,"wiki_url":3565,"discord_url":3565,"donation_urls":33191,"gallery":33194,"color":33195,"thread_id":33196,"monetization_status":30007},[1016,814],"ELQuZsJK","cataclysm-spellbooks-bettercombat-compat","YScWySJZ","Cataclysm: Spellbooks & BetterCombat - Compatibility","This is a datapack/mod for compatibility between Cataclysm: Spellbooks and Better Combat","[![JOIN OUR DISCORD](https://img.shields.io/badge/JOIN%20OUR%20DISCORD-5865F2?style=for-the-badge&logo=discord&logoColor=white)](https://discord.gg/4XUPywnEyE)\n\n**If you've play with Cataclysm: Spellbooks and Better Combat, you may have run into a problem where weapons from Cataclysm Spellbooks didn't work properly with the new combat system from Better Combat. This mod/datapack fills this gap between it, allowing players to use the unique weapons with the dynamic combat mechanics, without any problems!**\n\n**Features**\n- _Full Weapon Compatibility:_ This mod ensures complete integration of weapons from the Cataclysm mod with Better Combat's fighting mechanics.\n- _Attack Range Customization:_ You can customize each weapon to your liking, including attack range or weapon type. The files include notes on which values to edit, so even inexperienced users won't make a mistake!\n\n\n_This mod/datapack can be used in mod packs and modified as you see fit. If you need help adding compatibility for weapons from another mod, I'm ready to help! Feel free to contact me on Discord: @rymusov :)_\n\n[Report issue](https://github.com/rymusov/rymusov-mods-issues/issues) [Support me!](https://ko-fi.com/rymusov)","2025-08-27T12:02:54.341185Z","2025-09-02T12:25:25.315500Z","2025-08-27T21:49:55.357588Z","2025-08-27T12:16:18.205538Z",{"id":29977,"name":10,"url":3565},13440,[30,115,171,342,354,385],[134],[342,354,385],[33185,33186,33187,33188],"1Ri9KCXo","tYfiJEEj","T6b7OG7t","8cgD6A9Y","https://cdn.modrinth.com/data/ELQuZsJK/2742ad699cacd75c2a754d036456b5be0a7c1b01_96.webp","https://github.com/rymusov/rymusov-mods-issues/issues",[33192],{"id":3122,"platform":3123,"url":33193},"https://ko-fi.com/rymusov",[],12230783,"DBhsACD0",{"client_side":29963,"server_side":29963,"game_versions":33198,"id":33199,"slug":33200,"project_type":31,"team":33201,"organization":3565,"title":33202,"description":33203,"body":33204,"body_url":3565,"published":33205,"updated":33206,"approved":33207,"queued":33208,"status":29951,"requested_status":29951,"moderator_message":3565,"license":33209,"downloads":33210,"followers":30023,"categories":33211,"additional_categories":33212,"loaders":33213,"versions":33214,"icon_url":33218,"issues_url":3565,"source_url":3565,"wiki_url":3565,"discord_url":3565,"donation_urls":33219,"gallery":33221,"color":33222,"thread_id":33223,"monetization_status":30007},[1016,814],"QU6X0whW","waystones-cooldown","68QVfG0j","Waystones Cooldown","This addon adds the ability to edit the teleportation cooldown in the Waystones mod.","[![JOIN OUR DISCORD](https://img.shields.io/badge/JOIN%20OUR%20DISCORD-5865F2?style=for-the-badge&logo=discord&logoColor=white)](https://discord.gg/4XUPywnEyE)\n\nWaystones Cooldown is an addon for the popular mod Waystones, which adds the ability to edit the teleportation cooldown between waystones.\n\nWhat this addon does:\n- It adds a configurable cooldown period after each teleport using a waystone. By default, the player needs to wait ≥ 30 seconds before teleporting again using any waystone method (including the block itself, Warp Stone, or Warp Scroll).\n- The cooldown is applied individually for each player and helps balance fast travel in survival mode or on servers.\n- The cooldown duration is fully configurable through the mod's configuration file — you can set any value like.\n\nConfiguration file:\n```\n[general]\n\t#Base cooldown time (in seconds).\n\t#Range: 0 ~ 3600\n\tbaseCooldown = 30\n\t#Enable cooldown increase based on teleport distance.\n\tdistanceScaling = true\n\t#How many seconds to add per block of distance (0.1 = 1 second per 10 blocks).\n\t#Range: 0.001 ~ 10.0\n\tsecondsPerBlock = 0.1\n\t#Maximum possible cooldown time (in seconds).\n\t#Range: 0 ~ 86400\n\tmaxCooldown = 600\n\t#Сooldown after death (default=true).\n\tcooldownPersistsOnDeath = true\n\t#Radius in blocks within which teleportation has no cooldown (0 = disabled).\n\t#Range: 0 ~ 100000\n\tTeleportRadiusWithoutCooldown = 100\n\t#Additional cooldown time added when teleporting between dimensions. This value is added to the base cooldown (in seconds).\n\t#Range: 0 ~ 86400\n\tdimensionPenalty = 60\n```\n\n_This mod can be used in modpacks and modified as you see fit. If you need help , I'm ready to help! Feel free to contact me on Discord: @rymusov :)_","2025-12-22T13:02:41.211283Z","2026-03-23T19:49:44.180008Z","2026-01-06T02:14:53.048374Z","2025-12-22T13:44:19.342525Z",{"id":30132,"name":30133,"url":3565},2462,[30,171,297,354,385],[134],[354,385],[33215,33216,33217],"GQLAHnUP","5T32br37","nIbb9Yeu","https://cdn.modrinth.com/data/QU6X0whW/e2aa56a9040d2bc4d76ebbd60a9bc0c900bba1f4_96.webp",[33220],{"id":3122,"platform":3123,"url":33193},[],5790301,"KKanyIhK",{"client_side":30119,"server_side":29963,"game_versions":33225,"id":33226,"slug":33227,"project_type":342,"team":33228,"organization":3565,"title":33229,"description":33230,"body":33231,"body_url":3565,"published":33232,"updated":33233,"approved":33234,"queued":33235,"status":29951,"requested_status":29951,"moderator_message":3565,"license":33236,"downloads":33237,"followers":32521,"categories":33238,"additional_categories":33239,"loaders":33240,"versions":33241,"icon_url":33254,"issues_url":33190,"source_url":3565,"wiki_url":3565,"discord_url":3565,"donation_urls":33255,"gallery":33257,"color":33258,"thread_id":33259,"monetization_status":30007},[1016,814],"53TJSd8P","cataclysm-x-bettercombat-compat","fIF2xjmj","Cataclysm & BetterCombat - Compatibility","This is a datapack/mod for compatibility between Cataclysm and Better Combat","[![JOIN OUR DISCORD](https://img.shields.io/badge/JOIN%20OUR%20DISCORD-5865F2?style=for-the-badge&logo=discord&logoColor=white)](https://discord.gg/4XUPywnEyE)\n\n**If you've play with Cataclysm and Better Combat, you may have run into a problem where weapons from Cataclysm didn't work properly with the new combat system from Better Combat.\nThis mod/datapack fills this gap between it, allowing players to use the unique weapons with the dynamic combat mechanics, without any problems!**\n\n**Features**\n- _Full Weapon Compatibility:_ This mod ensures complete integration of weapons from the Cataclysm mod with Better Combat's fighting mechanics.\n- _Attack Range Customization:_ You can customize each weapon to your liking, including attack range or weapon type. The files include notes on which values to edit, so even inexperienced users won't make a mistake!\n\n_This mod/datapack can be used in mod packs and modified as you see fit.\nIf you need help adding compatibility for weapons from another mod, I'm ready to help! Feel free to contact me on Discord: @rymusov :)_\n\n[Report issue](https://github.com/rymusov/rymusov-mods-issues/issues)\n[Support me!](https://ko-fi.com/rymusov)","2025-08-25T16:06:48.550205Z","2025-12-18T19:18:30.120552Z","2025-08-26T22:44:57.598945Z","2025-08-26T11:49:55.057980Z",{"id":29977,"name":10,"url":3565},37787,[30,115,134,342,354,385],[171],[342,354,385],[33242,33243,33244,33245,33246,33247,33248,33249,33250,33251,33252,33253],"IeRVSSpn","Z6Hj53He","hR6SGvU7","n536RWb8","EiYYWmnu","lR2xPkg2","nf5leFXn","NQ9uQDY8","v8Zhnu79","bKqqAtgG","uz9NjyLr","CGWHkq5m","https://cdn.modrinth.com/data/53TJSd8P/e0d39aa11670104caf1e93e6c40be8ee5d55b080_96.webp",[33256],{"id":3122,"platform":3123,"url":33193},[],10235664,"9458CRYj",[33162,33153,33261],"projects","[\"user\",\"rymusov\",\"projects\"]",{"dehydratedAt":33149,"state":33264,"queryKey":33267,"queryHash":33269},{"data":33265,"dataUpdateCount":29979,"dataUpdatedAt":33266,"error":3565,"errorUpdateCount":29998,"errorUpdatedAt":29998,"fetchFailureCount":29998,"fetchFailureReason":3565,"fetchMeta":3565,"isInvalidated":439,"status":33159,"fetchStatus":33160},[],1779661701633,[33162,33153,33268],"organizations","[\"user\",\"rymusov\",\"organizations\"]",{"dehydratedAt":33149,"state":33271,"queryKey":33274,"queryHash":33276},{"data":33272,"dataUpdateCount":29979,"dataUpdatedAt":33273,"error":3565,"errorUpdateCount":29998,"errorUpdatedAt":29998,"fetchFailureCount":29998,"fetchFailureReason":3565,"fetchMeta":3565,"isInvalidated":439,"status":33159,"fetchStatus":33160},[],1779661701629,[33162,33153,33275],"collections","[\"user\",\"rymusov\",\"collections\"]",["Set"],["ShallowReactive",33279],{},"/user/rymusov/updates.json?neoforge=only"]</script><script defer src="https://static.