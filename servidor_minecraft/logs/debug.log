,634,628,583,577,532,478,472,459],"kpqbEsgs","itzrealme-edit","cxD0W4My","ItzRealMe Edit","An UNOFFICIAL ItzRealMe Texturepack","# ItzRealMe Edit\n**This is not an official ItzRealMe Texturepack!**\n\nThis texturepack adds:\n- Low Fire\n- No Fire Hurt Sound\n- No Sweep Hit Particle\n- No Explosion Particles\n- Clear Water\n- And More!","2024-09-24T22:57:28.686304Z","2026-04-20T19:45:06.448304Z","2024-09-26T22:05:11.355304Z","2024-09-24T23:04:15.419022Z",{"id":30132,"name":30133,"url":3565},135563,16,[77,303,307],[115,148],[377],[30317,30318,30319,30320,30321,30322,30323,30324,30325],"gB1p9YhF","Vyef3eM8","zLssmeW7","CkUYImUj","xrigGNQQ","yiEJHB3L","xUjrNYbh","AWH5Upme","IULA0peI","https://cdn.modrinth.com/data/kpqbEsgs/1606b72ed31fa28f803b0f4ff774a39c9f02fcbd_96.webp",[],[30329],{"url":30330,"raw_url":30331,"featured":822,"title":30332,"description":30333,"created":30334,"ordering":29998},"https://cdn.modrinth.com/data/kpqbEsgs/images/98cf1e0e9bdd3856b93b5fbb256f03bc1315ca96_350.webp","https://cdn.modrinth.com/data/kpqbEsgs/images/98cf1e0e9bdd3856b93b5fbb256f03bc1315ca96.png","Featured Image","Also a showcase!!","2024-09-24T23:04:11.187527Z",1315860,"nSsqlIpP",{"client_side":29963,"server_side":29964,"game_versions":30338,"id":30339,"slug":30340,"project_type":12,"team":30341,"organization":3565,"title":30342,"description":30343,"body":30344,"body_url":3565,"published":30345,"updated":30346,"approved":30347,"queued":30348,"status":29951,"requested_status":29951,"moderator_message":3565,"license":30349,"downloads":30350,"followers":29979,"categories":30351,"additional_categories":30352,"loaders":30353,"versions":30354,"icon_url":30356,"issues_url":3565,"source_url":3565,"wiki_url":3565,"discord_url":3565,"donation_urls":30357,"gallery":30358,"color":30359,"thread_id":30360,"monetization_status":30007},[733,685,643,634,628,583,577],"kqQgYRZQ","wynn-lobotomy-gathering","I31NrAW0","Wynn Lobotomy Gathering","Wynncraft Resource pack that has a 1 in 1000 chance of replacing the experince ding with a loud lobotomy sound effect.","Wynncraft Resource pack that has a 1 in 1000 chance of replacing the experince ding with a loud lobotomy sound effect. Recommend use is for gathering only. If you use it while not gathering I'm not paying any medical bills for hearing loss.\n\nMade in a hour to wake up people who are proffing for hours on end.","2025-11-24T08:47:24.628753Z","2025-11-24T09:33:06.968788Z","2025-11-28T08:23:56.999593Z","2025-11-24T09:04:59.748220Z",{"id":29977,"name":10,"url":3565},176,[50,93,303],[],[377],[30355],"P9P770Ko","https://cdn.modrinth.com/data/kqQgYRZQ/2d37f6342b7faade2c84be1497f22d571b708e55_96.webp",[],[],11440238,"MYBaSNHf",{"client_side":29963,"server_side":29964,"game_versions":30362,"id":30363,"slug":30364,"project_type":31,"team":30365,"organization":3565,"title":30366,"description":30367,"body":30368,"body_url":3565,"published":30369,"updated":30370,"approved":30371,"queued":30372,"status":29951,"requested_status":29951,"moderator_message":3565,"license":30373,"downloads":30374,"followers":29998,"categories":30375,"additional_categories":30376,"loaders":30377,"versions":30378,"icon_url":30380,"issues_url":3565,"source_url":3565,"wiki_url":3565,"discord_url":3565,"donation_urls":30381,"gallery":30382,"color":30387,"thread_id":30388,"monetization_status":30007},[814],"kpb2S1vg","steakpvptoggle","X09CRs9a","Steak's Pvp Toggle","A PvP utility mod that improves visibility by tweaking shields, view bobbing, and FOV effects. More features and optimizations are coming in future updates.","## Overview\n**Pvp Toggle** is a lightweight utility mod designed for competitive Minecraft players who value visual clarity. This mod eliminates distracting animations and optimizes your HUD, allowing you to stay focused on the fight.\n\n### Key Features:\n* **Enhanced Visibility:** Includes a built-in Gamma override, allowing you to boost brightness from the standard 300% up to 1500% for perfect vision in dark environments.\n* **Visual Cleanup:** Toggle or disable View Bobbing and FOV effects to keep your screen steady during high-speed combat.\n* **Compact View:** Makes shields and off-hand items smaller, significantly increasing your field of vision and reducing screen obstruction.\n* **Performance Focused:** Minimalist code ensures no impact on your FPS or system stability.\n\n### Future Plans:\nThe mod is under active development. Expect further visual optimizations and more HUD customization options in upcoming releases.\n\n### Contact:\nQuestions or feedback? Reach out here:\n* **Discord:** `hereviper`\n* Or use the Modrinth messaging system.","2026-04-28T11:05:27.236129Z","2026-04-28T11:13:37.701037Z","2026-04-29T00:51:39.504027Z","2026-04-28T11:39:29.499638Z",{"id":30132,"name":30133,"url":3565},34,[303],[134,211],[346],[30379],"JjPA62Ht","https://cdn.modrinth.com/data/kpb2S1vg/c88484cc1e481ee6ad2c8c6a4e8fc8d5789e3fa2_96.webp",[],[30383],{"url":30384,"raw_url":30385,"featured":439,"title":3565,"description":3565,"created":30386,"ordering":29998},"https://cdn.modrinth.com/data/kpb2S1vg/images/c88484cc1e481ee6ad2c8c6a4e8fc8d5789e3fa2_350.webp","https://cdn.modrinth.com/data/kpb2S1vg/images/c88484cc1e481ee6ad2c8c6a4e8fc8d5789e3fa2.png","2026-04-28T11:36:41.623383Z",855309,"hQULsCJ1",{"client_side":29963,"server_side":29964,"game_versions":30390,"id":30391,"slug":30392,"project_type":12,"team":30393,"organization":3565,"title":30394,"description":30395,"body":30396,"body_url":3565,"published":30397,"updated":30398,"approved":30399,"queued":30400,"status":29951,"requested_status":29951,"moderator_message":3565,"license":30401,"downloads":30402,"followers":29998,"categories":30403,"additional_categories":30404,"loaders":30405,"versions":30406,"icon_url":30408,"issues_url":30409,"source_url":3565,"wiki_url":30410,"discord_url":3565,"donation_urls":30411,"gallery":30412,"color":30387,"thread_id":30425,"monetization_status":30007},[1016,814],"kqM1OoTg","bub-gender-pack","Q47wUB10","[BUB] Gender Pack","Adds visual variants to mobs based on gender","# [BUB] Gender Pack\n\n**Example resource pack for GenderBub mod with different models and textures for male and female mobs.**\n\n### How it works\n\nThis pack uses Entity Texture Features and Entity Model Features to read the `bubgender` NBT tag added by GenderBub. When a mob spawns with `bubgender: male`, ETF applies an alternate texture, and EMF can load a separate model.\n\n### Use as a template\n\nYou can use this pack as a base to add gender variants for any mob:\n\n* Copy the folder structure for the mob you want\n* Create your own textures and models for males and females\n* Edit the `.properties` file, change the mob ID and point to your textures\n* For custom models, create a `.jem` file and set the condition to the `bubgender` NBT tag\n\n### Requirements\n\n- [GenderBub](https://modrinth.com/mod/genderbub)\n- [ETF (Entity Texture Features)](https://modrinth.com/mod/entitytexturefeatures)\n- [EMF (Entity Model Features)](https://modrinth.com/mod/entity-model-features)","2026-04-19T19:49:20.404945Z","2026-04-27T16:51:11.643063Z","2026-05-01T03:48:24.974498Z","2026-04-27T17:00:40.696217Z",{"id":30132,"name":30133,"url":3565},28,[],[],[377],[30407],"MlTUdqjF","https://cdn.modrinth.com/data/kqM1OoTg/603e42cee50621b3f69413411c83696863507385.png","https://github.com/be-bub/genderbub/issues","https://github.com/be-bub/genderbub/wiki",[],[30413,30417,30421],{"url":30414,"raw_url":30415,"featured":439,"title":3565,"description":3565,"created":30416,"ordering":29998},"https://cdn.modrinth.com/data/kqM1OoTg/images/2afd94adff1e8e46ea0d681aac2293ef94fd2cce_350.webp","https://cdn.modrinth.com/data/kqM1OoTg/images/2afd94adff1e8e46ea0d681aac2293ef94fd2cce.png","2026-04-27T16:58:08.150098Z",{"url":30418,"raw_url":30419,"featured":439,"title":3565,"description":3565,"created":30420,"ordering":29998},"https://cdn.modrinth.com/data/kqM1OoTg/images/5cf0a4c6ee90ed3ff44f420654852c0e692d1569_350.webp","https://cdn.modrinth.com/data/kqM1OoTg/images/5cf0a4c6ee90ed3ff44f420654852c0e692d1569.png","2026-04-27T16:57:55.111783Z",{"url":30422,"raw_url":30423,"featured":439,"title":3565,"description":3565,"created":30424,"ordering":29998},"https://cdn.modrinth.com/data/kqM1OoTg/images/a21e3cf57374dd98177763ed744fe5bfcc97441c_350.webp","https://cdn.modrinth.com/data/kqM1OoTg/images/a21e3cf57374dd98177763ed744fe5bfcc97441c.png","2026-04-27T16:58:18.167331Z","HxmBS287",{"client_side":29963,"server_side":29964,"game_versions":30427,"id":30428,"slug":30429,"project_type":31,"team":30430,"organization":3565,"title":30431,"description":30432,"body":30432,"body_url":3565,"published":30433,"updated":30434,"approved":30435,"queued":30436,"status":29951,"requested_status":29951,"moderator_message":3565,"license":30437,"downloads":30438,"followers":30439,"categories":30440,"additional_categories":30441,"loaders":30442,"versions":30443,"icon_url":30451,"issues_url":3565,"source_url":3565,"wiki_url":30452,"discord_url":3565,"donation_urls":30453,"gallery":30454,"color":30471,"thread_id":30428,"monetization_status":30007},[1070,1022,1016,935,820],"kppuBARb","illusioner-added-to-minecraft","7klTgg5b","Illusioner added to minecraft","This mod will add an unrealized mob, an Illusion, to the game. Now, after you fall asleep on the bed, waking up, there will be an Illusion next to you.","2023-06-14T15:39:17.302672Z","2024-07-26T07:53:54.933068Z","2023-06-17T01:16:35.793498Z","2023-06-14T15:45:22.244188Z",{"id":29977,"name":10,"url":3565},2857,8,[191],[115,171],[346,354,385],[30444,30445,30446,30447,30448,30449,30450],"ZCLMa43z","dsJy09cn","c4pVRwW0","RQvYfkyQ","6Ysy7e9M","l4UtOex7","Kbbz3pxB","https://cdn.modrinth.com/data/kppuBARb/f2085f959ded73b6f9ee00763d08ece0f4a7654a_96.webp","https://www.stevemods.com/post/illusor-added-to-minecraft-1-19-4",[],[30455,30460,30466],{"url":30456,"raw_url":30457,"featured":439,"title":30458,"description":30458,"created":30459,"ordering":29979},"https://cdn.modrinth.com/data/kppuBARb/images/c1ad3134196c3c90616dbd1279654d62cf2b16ae_350.webp","https://cdn.modrinth.com/data/kppuBARb/images/21f5aa46d510b0fe3a60a1c0b8e9a6c82da4ff65.png","1","2023-06-14T15:42:46.610099Z",{"url":30461,"raw_url":30462,"featured":439,"title":30463,"description":30463,"created":30464,"ordering":30465},"https://cdn.modrinth.com/data/kppuBARb/images/1da3ac26ee501f5825709cdc5abaee0aa8945135_350.webp","https://cdn.modrinth.com/data/kppuBARb/images/1da3ac26ee501f5825709cdc5abaee0aa8945135.png","3","2023-06-14T15:43:21.765599Z",3,{"url":30467,"raw_url":30468,"featured":439,"title":30469,"description":30469,"created":30470,"ordering":30465},"https://cdn.modrinth.com/data/kppuBARb/images/5f532462f68082589f3550ee18e1f368103013e1_350.webp","https://cdn.modrinth.com/data/kppuBARb/images/5f532462f68082589f3550ee18e1f368103013e1.png","2","2023-06-14T15:43:03.620799Z",8228750,{"client_side":30119,"server_side":30119,"game_versions":30473,"id":30474,"slug":30475,"project_type":31,"team":30476,"organization":3565,"title":30477,"description":30478,"body":30479,"body_url":3565,"published":30480,"updated":30481,"approved":30482,"queued":30483,"status":29952,"requested_status":29952,"moderator_message":3565,"license":30484,"downloads":30487,"followers":30488,"categories":30489,"additional_categories":30490,"loaders":30491,"versions":30492,"icon_url":30573,"issues_url":30574,"source_url":30575,"wiki_url":3565,"discord_url":3565,"donation_urls":30576,"gallery":30577,"color":30597,"thread_id":30474,"monetization_status":30007},[2192,2144,2135,2078,2069,2060,1868,1832,1829,1820,1817,1808,1805,1796,1790,1787,1784,1763,1760,1754,1751,1742,1727,1712,1688,1640,1631,1619,1613,1604,1598,1574,1565,1514,1511,1481,1475,1463,1442],"kr1RaEqy","hwyla","xKoDGZ1G","Hwyla","Hwyla (Here's What You're Looking At) is a UI improvement mod aimed at providing block information directly in-game. It is also a fork of Waila.","# Here's What You're Looking At \n\n\u003Ca href=\"https%253a%252f%252ftldrlegal.com%252flicense%252fcreative-commons-attribution-noncommercial-sharealike-4.0-international-(cc-by-nc-sa-4.0)\" rel=\"nofollow\">\u003Cimg src=\"https://camo.githubusercontent.com/9ff350810e0e0edb50226f67206cdb68b5f8c989/68747470733a2f2f696d672e736869656c64732e696f2f62616467652f6c6963656e73652d434325323042592d2d4e432d2d5341253230342e302d626c75652e737667\" alt=\"License\">\u003C/a>\n\n**HWYLA** (Pronounced \"Hwhy-la\", similar to \"Coo-Hwhip\")\n\n**Hwyla is available for both Forge and Fabric.**\n\nA fork of [WAILA](https://modrinth.com/mod/hwyla/settings/description) by [ProfMobius](https://www.curseforge.com/members/profmobius/projects). This fork is permitted under the [CC BY-NC-SA 4.0](https://github.com/TehNut/HWYLA/blob/1.10/LICENSE.md) license.\n\nAll plugins/addons/compatibilities&nbsp;created with the official mod are 100% compatible with this fork.\n\n\n## Changes\n\nYou can find a list of most changes right [here](https://github.com/TehNut/HWYLA/blob/1.10/CHANGES.md).\n\n## Notable Lesser Known Features\n- By default, Numpad 3 and Numpad 4 can be used to lookup the recipe of blocks in the world in JEI. This requires JEI to be installed to function.\n- You can change the colors and text formatting of the tooltip in-game by navigating to the in-game config, opening the \"Waila\" options screen, and selecting \"Format content...\".\n- If you are having issues with tooltip handlers added by mods, you can run `/dumphandlers` which will produce a text file with all registered handlers and what types they are registered to.\n- As of 1.12, the Narrator can be toggled for the tooltip. This will use the system's text-to-speech library to tell you what you're looking at.\n- If you feel that having the item being displayed in the tooltip is redundant, it can be disabled.\n\n## Modpack Permissions\nYou can use Hwyla in modpacks.\n\n## Archival notice\n**This mod is abandoned and has been uploaded for archival purposes. It was [originally created](https://curseforge.com/minecraft/mc-mods/hwyla) by [TehNut](https://legacy.curseforge.com/members/TehNut/projects) on Nov 9, 2016. It has been uploaded to Modrinth under the ModrinthArchives account with permission from the original author.**\n\n![Discord screenshot showing permission to upload](https://cdn.modrinth.com/archives/tehnut-permission.png)","2023-07-06T23:42:36.410784Z","2023-07-06T23:43:37.420207Z","2023-08-17T07:54:23.412556Z","2023-08-17T07:54:17.742684Z",{"id":30485,"name":30486,"url":3565},"CC-BY-NC-SA-4.0","Creative Commons Attribution Non Commercial Share Alike 4.0 International",500539,60,[157,303],[],[346,354],[30493,30494,30495,30496,30497,30498,30499,30500,30501,30502,30503,30504,30505,30506,30507,30508,30509,30510,30511,30512,30513,30514,30515,30516,30517,30518,30519,30520,30521,30522,30523,30524,30525,30526,30527,30528,30529,30530,30531,30532,30533,30534,30535,30536,30537,30538,30539,30540,30541,30542,30543,30544,30545,30546,30547,30548,30549,30550,30551,30552,30553,30554,30555,30556,30557,30558,30559,30560,30561,30562,30563,30564,30565,30566,30567,30568,30569,30570,30571,30572],"XfKJiKQ8","sP9rUU3H","TMVb3wST","vevrlwHm","PmvNiQ1f","cejhtAy8","Lh9moXF6","CGDrbkIj","Hg19JBJD","C3mSojpm","erC1vItA","9vRdSzIz","SJXTj9vo","CVPe4bA7","ZxMi0ws8","FIfvYYyR","DDQcWdY0","U6qaFnkB","LYCXKgiD","xfC3W3eJ","txzRWNcL","XHJr1mNG","k0J8tjdN","8P8yF0UP","1N9H9G1s","KtdE2yZT","AhWbpuGA","PVjnY7Ym","3GTxJnCy","q5cdDDuS","bST9A5y2","xZaHtwXQ","XJRKNa7C","RxevzLRe","H2NP6ajc","LI9xpnDD","Gy2ElbHJ","SFXmbAn7","pgcAdhbb","IQAp0oBM","92Evz44a","y33jL8Qu","m173hr9Y","NG0KaQuG","jNH2Ja6H","pIIwwNJq","YVBzgVnz","TzNEFY9v","rN628bRp","SYpz1UZE","ku0tyTiN","Si7EWoVG","gV5W98Dp","MbkImmIN","iK6XQex2","WfsGhvzS","MNpaM1En","XR86I9SK","qkf1OM5Y","IhmsNRqB","ikQou3M4","ruta6I1j","bkDzUKmY","OyLr73Nf","Yu55qL9J","qPCcGtcc","YHn4HoP2","jTZ50yL6","6833G2hF","pMnJKV6N","rPdI9Fak","1lNrSxYE","GdrH46nz","MD5YpBSC","yYek1zod","QKbVkmZx","6dWZbakU","1xqS6fYw","NyEQXIrz","FLn3akA2","https://cdn.modrinth.com