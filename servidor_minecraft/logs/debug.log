om/data/kqtVv2In/images/a1c4f4e62997dbfcb90593299ed13f95c8dcf713_350.webp","https://cdn.modrinth.com/data/kqtVv2In/images/a1c4f4e62997dbfcb90593299ed13f95c8dcf713.png","after","2025-10-09T15:04:30.374291Z",{"url":31809,"raw_url":31810,"featured":439,"title":31811,"description":3565,"created":31812,"ordering":30465},"https://cdn.modrinth.com/data/kqtVv2In/images/38e8e3f24bebf96afd37e17877f6d31394a6ac59_350.webp","https://cdn.modrinth.com/data/kqtVv2In/images/38e8e3f24bebf96afd37e17877f6d31394a6ac59.png","0.5","2025-10-10T16:38:46.839456Z",{"url":31814,"raw_url":31815,"featured":439,"title":31816,"description":3565,"created":31817,"ordering":30105},"https://cdn.modrinth.com/data/kqtVv2In/images/ac0158eae996a6814bead7c3126546915ab1f9e6_350.webp","https://cdn.modrinth.com/data/kqtVv2In/images/ac0158eae996a6814bead7c3126546915ab1f9e6.png","0.6","2025-10-12T12:53:18.007840Z",{"url":31819,"raw_url":31820,"featured":439,"title":31816,"description":3565,"created":31821,"ordering":31048},"https://cdn.modrinth.com/data/kqtVv2In/images/6de32e45ddc548b3439e9499f847985af1ffe58c_350.webp","https://cdn.modrinth.com/data/kqtVv2In/images/6de32e45ddc548b3439e9499f847985af1ffe58c.png","2025-10-12T12:53:32.540406Z",12235434,"KTPzMnRP",{"client_side":30119,"server_side":29963,"game_versions":31825,"id":31826,"slug":31827,"project_type":31,"team":31828,"organization":3565,"title":31829,"description":31830,"body":31831,"body_url":3565,"published":31832,"updated":31833,"approved":31834,"queued":3565,"status":29951,"requested_status":29951,"moderator_message":3565,"license":31835,"downloads":31836,"followers":31837,"categories":31838,"additional_categories":31839,"loaders":31840,"versions":31841,"icon_url":31845,"issues_url":3565,"source_url":3565,"wiki_url":3565,"discord_url":3565,"donation_urls":31846,"gallery":31847,"color":31873,"thread_id":31826,"monetization_status":30007},[1145],"kpuiilBk","craftian-forms","kiQgxfit","Craftian Forms (Cobblemon)","Minecraft themed regional variants for Cobblemon!","Craftian Forms are Minecraft themed regional Pokémon forms for the Cobblemon mod.\n\nIn the current release, there are 5 new Pokémon to find:\n\n\u003Cimg src=\"https://cdn.modrinth.com/data/kpuiilBk/images/5bb380a696f6c7807f976d5f9bd94001ed5b505c.png\" alt=\"drawing\" width=\"200\"/>\n\n**Craftian Wooper**\n*Water/Ice Type*\u003Cbr>\nCan be found in snowy biomes, near ice blocks.\n\n\u003Cimg src=\"https://cdn.modrinth.com/data/kpuiilBk/images/b30bda5a6d5618a7eb7f84fa995d758ade4a2385.png\" alt=\"drawing\" width=\"300\"/>\n\n**Glacire**\n*Water/Ice Type*\u003Cbr>\nEvolves from Craftian Wooper at level 20, or found in the same places as Craftian Wooper.\n\n\u003Cimg src=\"https://cdn.modrinth.com/data/kpuiilBk/images/e92f306a9a5b09f181ab7ed4d3ef7fbfd9f3271a.png\" alt=\"drawing\" width=\"200\"/>\n\n**Craftian Sableye**\n*Dark/Psychic Type*\u003Cbr>\nCan be found uncommonly in the Deep Dark.\n\n\u003Cimg src=\"https://cdn.modrinth.com/data/kpuiilBk/images/b07bb96a4f0f24f96730d99391da62861c0a22c2.png\" alt=\"drawing\" width=\"200\"/>\n\u003Cimg src=\"https://cdn.modrinth.com/data/kpuiilBk/images/00ddebde3fe2096733cc0f0bacba4e3d97a586cf.png\" alt=\"drawing\" width=\"200\"/>\n\n**Craftian Magnemite** and **Craftian Magneton**\n*Psychic Type*\u003Cbr>\nIntended to spawn in The End, but I could not find them in testing. The final stage of the evolution line will be coming in a later version. Additionally, due to a quirk with Cobblemon's multiple forms system, they are currently dual type *Psychic/Psychic*. ","2023-02-01T04:50:02.238934Z","2023-03-31T13:57:11.683738Z","2023-02-01T22:59:51.322221Z",{"id":30132,"name":30133,"url":3565},3365,38,[30,191],[],[342],[31842,31843,31844],"RT3xbSJ6","8eM04WTl","5LS7NZNr","https://cdn.modrinth.com/data/kpuiilBk/daf03170ad743efc003a2065cfef27b7cc4d97a8.png",[],[31848,31853,31858,31863,31868],{"url":31849,"raw_url":31849,"featured":439,"title":31850,"description":31851,"created":31852,"ordering":29998},"https://cdn.modrinth.com/data/kpuiilBk/images/00ddebde3fe2096733cc0f0bacba4e3d97a586cf.png","Craftian Magneton","Isometric render of Craftian Magneton","2023-02-01T04:58:44.303685Z",{"url":31854,"raw_url":31854,"featured":439,"title":31855,"description":31856,"created":31857,"ordering":29998},"https://cdn.modrinth.com/data/kpuiilBk/images/5bb380a696f6c7807f976d5f9bd94001ed5b505c.png","Craftian Wooper","Isometric render of Craftian Wooper","2023-02-01T04:55:54.900537Z",{"url":31859,"raw_url":31859,"featured":439,"title":31860,"description":31861,"created":31862,"ordering":29998},"https://cdn.modrinth.com/data/kpuiilBk/images/b07bb96a4f0f24f96730d99391da62861c0a22c2.png","Craftian Magnemite","Isometric render of Craftian Magnemite","2023-02-01T04:58:07.388375Z",{"url":31864,"raw_url":31864,"featured":439,"title":31865,"description":31866,"created":31867,"ordering":29998},"https://cdn.modrinth.com/data/kpuiilBk/images/b30bda5a6d5618a7eb7f84fa995d758ade4a2385.png","Glacire","Isometric render of Glacire, the evolution of Craftian Wooper","2023-02-01T04:56:37.769305Z",{"url":31869,"raw_url":31869,"featured":439,"title":31870,"description":31871,"created":31872,"ordering":29998},"https://cdn.modrinth.com/data/kpuiilBk/images/e92f306a9a5b09f181ab7ed4d3ef7fbfd9f3271a.png","Craftian Sableye","Isometric render of Craftian Sableye","2023-02-01T04:55:25.395252Z",9217705,{"client_side":29963,"server_side":29964,"game_versions":31875,"id":31876,"slug":31877,"project_type":12,"team":31878,"organization":3565,"title":31879,"description":31880,"body":31881,"body_url":3565,"published":31882,"updated":31883,"approved":31884,"queued":31885,"status":29951,"requested_status":29951,"moderator_message":3565,"license":31886,"downloads":31887,"followers":31215,"categories":31888,"additional_categories":31889,"loaders":31890,"versions":31891,"icon_url":31894,"issues_url":3565,"source_url":3565,"wiki_url":3565,"discord_url":3565,"donation_urls":31895,"gallery":31896,"color":31917,"thread_id":31918,"monetization_status":30007},[1022,1016,983,941,935,863,857,820,814,766,763,733,685,643,634,628,583,577,532],"kqygRbcY","winter-time","luhcppl8","Winter Time","Covers the World in a Nice Layer of Snow for Winter Vibes.","Need a server for you and your friends? click the image below: [![](https://cdn.apexminecrafthosting.com/img/theme/apex-hosting-mobile.png)](https://billing.apexminecrafthosting.com/aff.php?aff=16230)\n\n# Winter Time V2\nWinter Time turns your world into a Wonderfull Snowy Landscape with colder colours for plants and flowers. This changes crops, flowers, saplins, trees, vines. This pack is great if you are in the wintery feel for things or getting ready to enjoy the winter holidays.\n## Changes\n- Grass and foliage Colour Maps to a mix of white and blue.\n- Leaf Litter Colour Map to be a little bit more white to fit in with the snow.\n- Saplings have Snow on them to match Trees.\n- Most Flowers have been changed.\n- Birch and Spruce Leaves to Fit in Better.\n- Makes Water Icy\n## Preview\n![House1](https://cdn.modrinth.com/data/cached_images/16526b3328fc31691255d9593e479b34bb9064b6.png)\n\n## My Socials\nMy YouTube: [https://www.youtube.com/@sirjumpy8772](https://www.youtube.com/@sirjumpy8772)\n\nMy TikTok: [https://www.tiktok.com/@sirjumpy8772](https://www.tiktok.com/@sirjumpy8772)","2024-12-03T14:01:39.095701Z","2025-12-23T22:30:33.129399Z","2024-12-06T06:55:11.473465Z","2024-12-03T14:27:17.499514Z",{"id":30248,"name":30249,"url":3565},4939,[113,292,307],[15,57,100],[377],[31892,31893],"te10Kkrh","nvzIczYW","https://cdn.modrinth.com/data/kqygRbcY/74e861f15d4646d1ada59d7cc313197c9425fe1f_96.webp",[],[31897,31902,31907,31912],{"url":31898,"raw_url":31899,"featured":439,"title":31900,"description":3565,"created":31901,"ordering":29998},"https://cdn.modrinth.com/data/kqygRbcY/images/16526b3328fc31691255d9593e479b34bb9064b6_350.webp","https://cdn.modrinth.com/data/kqygRbcY/images/16526b3328fc31691255d9593e479b34bb9064b6.png","House","2025-12-23T22:36:00.399841Z",{"ur