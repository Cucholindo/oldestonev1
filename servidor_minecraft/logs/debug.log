.\n- _Attack Range Customization:_ You can customize each weapon to your liking, including attack range or weapon type. The files include notes on which values to edit, so even inexperienced users won't make a mistake!\n\n\n_This mod/datapack can be used in mod packs and modified as you see fit. If you need help adding compatibility for weapons from another mod, I'm ready to help! Feel free to contact me on Discord: @rymusov :)_\n\n[Report issue](https://github.com/rymusov/rymusov-mods-issues/issues) [Support me!](https://ko-fi.com/rymusov)","2025-08-27T12:02:54.341185Z","2025-09-02T12:25:25.315500Z","2025-08-27T21:49:55.357588Z","2025-08-27T12:16:18.205538Z",{"id":29977,"name":10,"url":3565},13440,[30,115,171,342,354,385],[134],[342,354,385],[33250,33251,33252,33253],"1Ri9KCXo","tYfiJEEj","T6b7OG7t","8cgD6A9Y","https://cdn.modrinth.com/data/ELQuZsJK/2742ad699cacd75c2a754d036456b5be0a7c1b01_96.webp",[33256],{"id":3122,"platform":3123,"url":33191},[],12230783,"DBhsACD0",1779661700395,[33162,33153,33262],"projects","[\"user\",\"rymusov\",\"projects\"]",{"dehydratedAt":33149,"state":33265,"queryKey":33268,"queryHash":33270},{"data":33266,"dataUpdateCount":29979,"dataUpdatedAt":33267,"error":3565,"errorUpdateCount":29998,"errorUpdatedAt":29998,"fetchFailureCount":29998,"fetchFailureReason":3565,"fetchMeta":3565,"isInvalidated":439,"status":33159,"fetchStatus":33160},[],1779661700393,[33162,33153,33269],"organizations","[\"user\",\"rymusov\",\"organizations\"]",{"dehydratedAt":33149,"state":33272,"queryKey":33274,"queryHash":33276},{"data":33273,"dataUpdateCount":29979,"dataUpdatedAt":33149,"error":3565,"errorUpdateCount":29998,"errorUpdatedAt":29998,"fetchFailureCount":29998,"fetchFailureReason":3565,"fetchMeta":3565,"isInvalidated":439,"status":33159,"fetchStatus":33160},[],[33162,33153,33275],"collections","[\"user\",\"rymusov\",\"collections\"]",["Set"],["ShallowReactive",33279],{},"/user/rymusov/updates.json?neoforge=only"]</script><script defer src="https://static.