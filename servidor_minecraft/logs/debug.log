duct_id":33118,"prices":33125,"currency_code":32824},"3M0XyRUk",{"type":32572,"intervals":33126},{"yearly":33127,"quarterly":33128,"monthly":33129},138000,34800,13800,{"2025":32845,"2026":33131},2000,"2026-05-24T19:15:07.374Z","https://api.modrinth.com/v2/",[],2026,{"user":3565,"token":10},[],"right",{"developerMode":439,"demoMode":439,"showVersionFilesInTable":439,"showAdsWithPlus":439,"alwaysShowChecklistAsPopup":822,"testTaxForm":439,"projectTypesPrimaryNav":439,"enableMedalPromotion":822,"hidePlusPromoInUserMenu":439,"projectBackground":439,"searchBackground":439,"advancedDebugInfo":439,"FilesRefreshButton":439,"showProjectPageDownloadModalServersPromo":439,"showProjectPageCreateServersTooltip":822,"showProjectPageQuickServerButton":439,"newProjectGeneralSettings":439,"newProjectEnvironmentSettings":822,"serverRamAsBytesAlwaysOn":439,"archonSentryCapture":439,"hideRussiaCensorshipBanner":439,"disablePrettyProjectUrlRedirects":439,"hidePreviewBanner":439,"i18nDebug":439,"showDiscoverProjectButtons":439,"useV1ContentTabAPI":822,"labrinthApiCanary":439,"dismissedExternalProjectsInfo":439,"modpackPermissionsPage":439,"showAllBanners":439,"alwaysIgnoreErrorBanner":439,"showViewProdRouteBanner":439,"showModeratorProjectMemberUi":439,"showModeratorPrivateMessageHighlight":822},["Map"],{"collections":33142,"follows":33143,"subscriptions":33144,"lastUpdated":29998},[],[],[],{"mutations":33146,"queries":33147},[],[33148,33164,33264,33271],{"dehydratedAt":33149,"state":33150,"queryKey":33161,"queryHash":33163},1779661700397,{"data":33151,"dataUpdateCount":29979,"dataUpdatedAt":33158,"error":3565,"errorUpdateCount":29998,"errorUpdatedAt":29998,"fetchFailureCount":29998,"fetchFailureReason":3565,"fetchMeta":3565,"isInvalidated":439,"status":33159,"fetchStatus":33160},{"id":33152,"username":33153,"name":3565,"avatar_url":33154,"bio":33155,"created":33156,"role":33157,"badges":29998,"auth_providers":3565,"email":3565,"email_verified":3565,"has_password":3565,"has_totp":3565,"payout_data":3565,"github_id":3565},"silXZKbC","rymusov","https://cdn.modrinth.com/user/silXZKbC/4fbfe0110cfe7b706cf0a86f8b328951c62c65e8.jpeg","Wassup, I'm Rymusov and I'm trying to make some stuff for Minecraft (and maybe more content in the future)!\nKnown languages: Ukranian, Russian, English","2024-03-20T20:14:49.394325Z","developer",1779661700392,"success","idle",[33162,33153],"user","[\"user\",\"rymusov\"]",{"dehydratedAt":33149,"state":33165,"queryKey":33261,"queryHash":33263},{"data":33166,"dataUpdateCount":29979,"dataUpdatedAt":33260,"error":3565,"errorUpdateCount":29998,"errorUpdatedAt":29998,"fetchFailureCount":29998,"fetchFailureReason":3565,"fetchMeta":3565,"isInvalidated":439,"status":33159,"fetchStatus":33160},[33167,33195,33232],{"client_side":29963,"server_side":29963,"game_versions":33168,"id":33169,"slug":33170,"project_type":31,"team":33171,"organization":3565,"title":33172,"description":33173,"body":33174,"body_url":3565,"published":33175,"updated":33176,"approved":33177,"queued":33178,"status":29951,"requested_status":29951,"moderator_message":3565,"license":33179,"downloads":33180,"followers":30023,"categories":33181,"additional_categories":33182,"loaders":33183,"versions":33184,"icon_url":33188,"issues_url":3565,"source_url":3565,"wiki_url":3565,"discord_url":3565,"donation_urls":33189,"gallery":33192,"color":33193,"thread_id":33194,"monetization_status":30007},[1016,814],"QU6X0whW","waystones-cooldown","68QVfG0j","Waystones Cooldown","This addon adds the ability to edit the teleportation cooldown in the Waystones mod.","[![JOIN OUR DISCORD](https://img.shields.io/badge/JOIN%20OUR%20DISCORD-5865F2?style=for-the-badge&logo=discord&logoColor=white)](https://discord.gg/4XUPywnEyE)\n\nWaystones Cooldown is an addon for the popular mod Waystones, which adds the ability to edit the teleportation cooldown between waystones.\n\nWhat this addon does:\n- It adds a configurable cooldown period after each teleport using a waystone. By default, the player needs to wait ≥ 30 seconds before teleporting again using any waystone method (including the block itself, Warp Stone, or Warp Scroll).\n- The cooldown is applied individually for each player and helps balance fast travel in survival mode or on servers.\n- The cooldown duration is fully configurable through the mod's configuration file — you can set any value like.\n\nConfiguration file:\n```\n[general]\n\t#Base cooldown time (in seconds).\n\t#Range: 0 ~ 3600\n\tbaseCooldown = 30\n\t#Enable cooldown increase based on teleport distance.\n\tdistanceScaling = true\n\t#How many seconds to add per block of distance (0.1 = 1 second per 10 blocks).\n\t#Range: 0.001 ~ 10.0\n\tsecondsPerBlock = 0.1\n\t#Maximum possible cooldown time (in seconds).\n\t#Range: 0 ~ 86400\n\tmaxCooldown = 600\n\t#Сooldown after death (default=true).\n\tcooldownPersistsOnDeath = true\n\t#Radius in blocks within which teleportation has no cooldown (0 = disabled).\n\t#Range: 0 ~ 100000\n\tTeleportRadiusWithoutCooldown = 100\n\t#Additional cooldown time added when teleporting between dimensions. This value is added to the base cooldown (in seconds).\n\t#Range: 0 ~ 86400\n\tdimensionPenalty = 60\n```\n\n_This mod can be used in modpacks and modified as you see fit. If you need help , I'm ready to help! Feel free to contact me on Discord: @rymusov :)_","2025-12-22T13:02:41.211283Z","2026-03-23T19:49:44.180008Z","2026-01-06T02:14:53.048374Z","2025-12-22T13:44:19.342525Z",{"id":30132,"name":30133,"url":3565},2462,[30,171,297,354,385],[134],[354,385],[33185,33186,33187],"GQLAHnUP","5T32br37","nIbb9Yeu","https://cdn.modrinth.com/data/QU6X0whW/e2aa56a9040d2bc4d76ebbd60a9bc0c900bba1f4_96.webp",[33190],{"id":3122,"platform":3123,"url":33191},"https://ko-fi.com/rymusov",[],5790301,"KKanyIhK",{"client_side":30119,"server_side":29963,"game_versions":33196,"id":33197,"slug":33198,"project_type":342,"team":33199,"organization":3565,"title":33200,"description":33201,"body":33202,"body_url":3565,"published":33203,"updated":33204,"approved":33205,"queued":33206,"status":29951,"requested_status":29951,"moderator_message":3565,"license":33207,"downloads":33208,"followers":32521,"categories":33209,"additional_categories":33210,"loaders":33211,"versions":33212,"icon_url":33225,"issues_url":33226,"source_url":3565,"wiki_url":3565,"discord_url":3565,"donation_urls":33227,"gallery":33229,"color":33230,"thread_id":33231,"monetization_status":30007},[1016,814],"53TJSd8P","cataclysm-x-bettercombat-compat","fIF2xjmj","Cataclysm & BetterCombat - Compatibility","This is a datapack/mod for compatibility between Cataclysm and Better Combat","[![JOIN OUR DISCORD](https://img.shields.io/badge/JOIN%20OUR%20DISCORD-5865F2?style=for-the-badge&logo=discord&logoColor=white)](https://discord.gg/4XUPywnEyE)\n\n**If you've play with Cataclysm and Better Combat, you may have run into a problem where weapons from Cataclysm didn't work properly with the new combat system from Better Combat.\nThis mod/datapack fills this gap between it, allowing players to use the unique weapons with the dynamic combat mechanics, without any problems!**\n\n**Features**\n- _Full Weapon Compatibility:_ This mod ensures complete integration of weapons from the Cataclysm mod with Better Combat's fighting mechanics.\n- _Attack Range Customization:_ You can customize each weapon to your liking, including attack range or weapon type. The files include notes on which values to edit, so even inexperienced users won't make a mistake!\n\n_This mod/datapack can be used in mod packs and modified as you see fit.\nIf you need help adding compatibility for weapons from another mod, I'm ready to help! Feel free to contact me on Discord: @rymusov :)_\n\n[Report issue](https://github.com/rymusov/rymusov-mods-issues/issues)\n[Support me!](https://ko-fi.com/rymusov)","2025-08-25T16:06:48.550205Z","2025-12-18T19:18:30.120552Z","2025-08-26T22:44:57.598945Z","2025-08-26T11:49:55.057980Z",{"id":29977,"name":10,"url":3565},37787,[30,115,134,342,35