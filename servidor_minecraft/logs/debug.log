.com/data/krkd4rk0/images/4c565ff69404055f494719892f40ef8883cc6803_350.webp","https://cdn.modrinth.com/data/krkd4rk0/images/4c565ff69404055f494719892f40ef8883cc6803.png","Murublight Shelf","2025-05-23T05:58:38.814882Z",{"url":30942,"raw_url":30943,"featured":439,"title":30944,"description":3565,"created":30945,"ordering":29998},"https://cdn.modrinth.com/data/krkd4rk0/images/4e7e9c4fca5c6d75da3e8f85d0ac0ef763687ecf_350.webp","https://cdn.modrinth.com/data/krkd4rk0/images/4e7e9c4fca5c6d75da3e8f85d0ac0ef763687ecf.png","Murublight Chanterelle","2025-05-17T16:30:37.383180Z",{"url":30947,"raw_url":30948,"featured":439,"title":30949,"description":3565,"created":30950,"ordering":29998},"https://cdn.modrinth.com/data/krkd4rk0/images/4fa8660344e41b7189c75114c3866c51f3430f4a_350.webp","https://cdn.modrinth.com/data/krkd4rk0/images/4fa8660344e41b7189c75114c3866c51f3430f4a.png","Corrupt Growth","2025-05-23T05:58:17.272464Z",{"url":30952,"raw_url":30953,"featured":439,"title":30954,"description":3565,"created":30955,"ordering":29998},"https://cdn.modrinth.com/data/krkd4rk0/images/794423cbe83351602611f37a7ef7deea4281cc45_350.webp","https://cdn.modrinth.com/data/krkd4rk0/images/794423cbe83351602611f37a7ef7deea4281cc45.png","Chorus Sprouts","2025-05-23T05:57:39.941186Z",{"url":30957,"raw_url":30958,"featured":439,"title":30959,"description":3565,"created":30960,"ordering":29998},"https://cdn.modrinth.com/data/krkd4rk0/images/c4486f2344bd09302bd4bc4a7eb54f67e9b5ae5d_350.webp","https://cdn.modrinth.com/data/krkd4rk0/images/c4486f2344bd09302bd4bc4a7eb54f67e9b5ae5d.png","Murublight Cap","2025-05-17T16:31:28.609544Z",6097032,"w0gdZ6LL",{"client_side":29963,"server_side":29964,"game_versions":30964,"id":30965,"slug":30966,"project_type":12,"team":30967,"organization":3565,"title":30968,"description":30969,"body":30970,"body_url":3565,"published":30971,"updated":30972,"approved":30973,"queued":30974,"status":29951,"requested_status":29951,"moderator_message":3565,"license":30975,"downloads":30978,"followers":29998,"categories":30979,"additional_categories":30980,"loaders":30981,"versions":30982,"icon_url":30984,"issues_url":3565,"source_url":3565,"wiki_url":3565,"discord_url":3565,"donation_urls":30985,"gallery":30986,"color":31003,"thread_id":31004,"monetization_status":30007},[820,814,766,763,733,685,643,634,628,583],"kpfIOXUl","noto-kufi-font-for-arabic,-persian-and-others","cj0kasnh","Noto Kufi Font for Arabic, Persian and others","Change default font for languages with Arabic Script to the more readable Noto Kufi Font (Semibold)","Change default font for languages with Arabic Script to the more readable Noto Kufi Font (Semibold)\n\n(Also changes Latin Letters)","2025-10-05T22:14:43.865642Z","2025-10-05T22:16:31.980406Z","2025-10-06T06:59:40.986003Z","2025-10-05T22:59:09.877597Z",{"id":30976,"name":30977,"url":3565},"BSD-2-Clause","BSD 2-Clause \"Simplified\" License",215,[128],[],[377],[30983],"3sZ3w7ip","https://cdn.modrinth.com/data/kpfIOXUl/41e744bb163bae41221f8fe522df50a97ceecd96_96.webp",[],[30987,30991,30995,30999],{"url":30988,"raw_url":30989,"featured":439,"title":30816,"description":3565,"created":30990,"ordering":29979},"https://cdn.modrinth.com/data/kpfIOXUl/images/1b7b13e8dabbb34ac799d0b5d428a4b4bc500c8e_350.webp","https://cdn.modrinth.com/data/kpfIOXUl/images/1b7b13e8dabbb34ac799d0b5d428a4b4bc500c8e.png","2025-10-05T22:18:57.110901Z",{"url":30992,"raw_url":30993,"featured":439,"title":30810,"description":3565,"created":30994,"ordering":30023},"https://cdn.modrinth.com/data/kpfIOXUl/images/b930a5442a4662cb138794912805322ed5b303f2_350.webp","https://cdn.modrinth.com/data/kpfIOXUl/images/b930a5442a4662cb138794912805322ed5b303f2.png","2025-10-05T22:19:11.040355Z",{"url":30996,"raw_url":30997,"featured":439,"title":30816,"description":3565,"created":30998,"ordering":30465},"https://cdn.modrinth.com/data/kpfIOXUl/images/cecfe20618f9313f193c77f403fe52eff2d4d428_350.webp","https://cdn.modrinth.com/data/kpfIOXUl/images/cecfe20618f9313f193c77f403fe52eff2d4d428.png","2025-10-05T22:19:28.568634Z",{"url":31000,"raw_url":31001,"featured":439,"title":30810,"description":3565,"created":31002,"ordering":30105},"https://cdn.modrinth.com/data/kpfIOXUl/images/33b83230d2689359af269e6cf1a74348fab926e2_350.webp","https://cdn.modrinth.com/data/kpfIOXUl/images/33b83230d2689359af269e6cf1a74348fab926e2.png","2025-10-05T22:19:37.829215Z",1578520,"ZhfkpF59",{"client_side":30119,"server_side":29963,"game_versions":31006,"id":31007,"slug":31008,"project_type":31,"team":31009,"organization":3565,"title":31010,"description":31011,"body":31012,"body_url":3565,"published":31013,"updated":31014,"approved":31015,"queued":31016,"status":29951,"requested_status":29951,"moderator_message":3565,"license":31017,"downloads":30312,"followers":29998,"categories":31020,"additional_categories":31021,"loaders":31022,"versions":31023,"icon_url":31025,"issues_url":31026,"source_url":3565,"wiki_url":3565,"discord_url":3565,"donation_urls":31027,"gallery":31028,"color":31054,"thread_id":31055,"monetization_status":30007},[459],"kpwhwrp4","dimension-notifier","t3nntLJw","Dimension Notifier","Notifies players when they change dimensions, with server chat announcements and vanilla Tab list dimension labels.","# Dimension Notifier\n\nDimension Notifier gives players a clear alert when they move between dimensions. It shows a short action-bar message on dimension change, and when installed server-side it can also announce travel in chat and keep the vanilla Tab list grouped by dimension.\n\nThe mod is server-first for multiplayer. Dedicated servers can run it without requiring players to install anything, while client installs add local alert preferences, Mod Menu settings, and singleplayer support.\n\n## Chat Announcements & Action-bar Alert\n\n![image](https://cdn.modrinth.com/data/kpwhwrp4/images/7255b033fb0bdbea52c50d1b64866938193b7823.png)\n\n![image](https://cdn.modrinth.com/data/kpwhwrp4/images/db9dba6693daae3dc6990d958b4b7f9a5ff7cb42.png)\n\n![image](https://cdn.modrinth.com/data/kpwhwrp4/images/68d4848fbeb540b8eb820a92ed15f04ef9beaab2.png)\n\n## Tab Dimension Labels\n\nDefault:\n\n![image](https://cdn.modrinth.com/data/kpwhwrp4/images/701466d298824f35bf34d5a3d5efb02e24649aeb.png)\n\nCompacted:\n\n![image](https://cdn.modrinth.com/data/kpwhwrp4/images/c874fb2aff706ea4c5c4c74c428a5c262cd6f94f.png)\n\n## Mod Menu Settings\n\n![image](https://cdn.modrinth.com/data/kpwhwrp4/images/257de0eabdb2233c3a9c9403e068f5b010ec50f6.png)\n\nWhat is Mod Menu? You can check it [here](https://modrinth.com/mod/modmenu).\n\n## What Works Where\n\n| Feature | Singleplayer | Multiplayer requirement | If only your client has the mod |\n| --- | --- | --- | --- |\n| [Action-bar Alert](#chat-announcements--action-bar-alert) | Works locally when you change dimensions. | Server install covers vanilla clients. Client install lets that player control local alert settings. | Works for you only. |\n| [Chat Announcements](#chat-announcements--action-bar-alert) | Works in the integrated server. | Requires the server to run the mod. Everyone sees the server message. | Not available. |\n| [Tab Dimension Labels](#tab-dimension-labels) | Works in the integrated server. | Requires the server to run the mod. Everyone sees dimension labels in Tab. | Not available. |\n| [Mod Menu Settings](#mod-menu-settings) | Editable when Mod Menu is installed. | Local alerts are editable. Server features are read-only on remote servers. | Local alert settings only. |\n\n## Config\n\nAfter first launch, edit:\n\n```text\nconfig/dimension-notifier.properties\n```\n\nDefault config:\n\n```properties\n# Master toggle for server-backed Dimension Notifier features.\nenabled=true\n\n# Shows \"Entered \u003CDimension>\" above the hotbar when a player changes dimensions.\naction_bar_notifications=true\n\n# Adds destination block coordinates to action-bar alerts.\naction_bar_coordinates=false\n\n# Sends a server chat message when a player changes dimensions.\nbroadcast_dimension_changes=true\n\n# Adds destination block coordinates to server chat announcements.\nbroadcast_dimension_change_coordinates=true\n\n# Adds the current dimension before each name in the vanilla Tab list.\ntab_list_dimension_labels=true\n\n# Uses compact badges such as OVR, NET, and END instead of full dimension names.\ntab_list_compact_dimension_labels=false\n\n# Groups vanilla Tab rows by dimension.\ntab_list_dimension_sorting=true\n\n# Controls top-to-bottom Tab grouping order. Unlisted dimensions sort after this list.\ntab_list_dimension_order=minecraft:overworld,minecraft:the_nether,minecraft:the_end\n```\n\nFile edits require a game or server restart. Mod Menu changes apply immediately where editable. On remote multiplayer servers, server features are controlled by the server and appear read-only.\n\n## Support and License\n\nReport issues at [minecraft-addons](https://github.com/bearaujus-dungeon/minecraft-addons).\n\nDimension Notifier is distributed under the [Bearaujus Proprietary License v1.0](https://github.com/bearaujus-dungeon/minecraft-addons/blob/main/LICENSE.txt).\n\nDimension Notifier is not official Minecraft content and is not approved by or associated with Mojang or Microsoft.\n","2026-05-20T16:33:10.685138Z","2026-05-23T06:22:27.243442Z","2026-05-23T23:16:58.489098Z","2026-05-21T14:36:06.860867Z",{"id":31018,"name":10,"url":31019},"LicenseRef-Bearaujus-Proprietary-License-v1.0","https://github.com/bearaujus-dungeon/minecraft-addons/blob/main/LICENSE.txt",[275,288,303],[],[346],[31024],"aeDbC2Tx","https://cdn.modrinth.com/data/kpwhwrp4/a76f2fe1d2f3164c39b1671aee81c11037bc6284_96.webp","https://github.com/bearaujus-dungeon/minecraft-addons/issues",[],[31029,31033,31037,31041,31044,31049],{"url":31030,"raw_url":31031,"featured":439,"title":3565,"description":3565,"created":31032,"ordering":29979},"https://cdn.modrinth.com/data/kpwhwrp4/images/7255b033fb0bdbea52c50d1b64866938193b7823_350.webp","https://cdn.modrinth.com/data/kpwhwrp4/image