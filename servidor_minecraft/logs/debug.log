 menu. Here you can add commands (make sure to expand everything).\n\nIf you want a command button for each player you can use `{{player}}` and `{{scoreboard_player}}`.\n\nFor example:\n- `/tp @s {{player}}`\n- `/spectate {{scoreboard_player}}`\n\netc.","2025-04-20T18:28:17.711752Z","2025-04-21T11:50:11.268868Z","2025-04-24T05:40:49.277193Z","2025-04-20T19:15:36.390083Z",{"id":30248,"name":30249,"url":3565},320,[303],[],[346],[30685,30686,30687],"S1lNWAPC","yx97WKWx","LisccX5i","https://cdn.modrinth.com/data/krWUqWpj/be5424af4850c2f8aea2d5baac9c610f41597aa9_96.webp","https://gitlab.com/billyg270/command-popup/-/issues","https://gitlab.com/billyg270/command-popup","https://discord.gg/B7YnjjMwCC",[],[30694,30699,30704],{"url":30695,"raw_url":30696,"featured":439,"title":30697,"description":3565,"created":30698,"ordering":29998},"https://cdn.modrinth.com/data/krWUqWpj/images/0367f29fdbeed7076320103a0803b5a0f35195a7_350.webp","https://cdn.modrinth.com/data/krWUqWpj/images/0367f29fdbeed7076320103a0803b5a0f35195a7.png","On main menu","2025-04-20T19:14:49.012568Z",{"url":30700,"raw_url":30701,"featured":439,"title":30702,"description":3565,"created":30703,"ordering":29998},"https://cdn.modrinth.com/data/krWUqWpj/images/044aceb25017d1dd73c84c37c23c70a731a819b5_350.webp","https://cdn.modrinth.com/data/krWUqWpj/images/044aceb25017d1dd73c84c37c23c70a731a819b5.png","In mod menu","2025-04-20T19:15:02.841304Z",{"url":30705,"raw_url":30706,"featured":822,"title":30707,"description":3565,"created":30708,"ordering":29998},"https://cdn.modrinth.com/data/krWUqWpj/images/8b4d81eca5016c14a6d942132d9bd194d98a4b2c_350.webp","https://cdn.modrinth.com/data/krWUqWpj/images/8b4d81eca5016c14a6d942132d9bd194d98a4b2c.png","After clicking one of the command buttons","2025-04-20T19:15:25.038241Z",2113636,"tGTp81ck",{"client_side":29963,"server_side":29964,"game_versions":30712,"id":30713,"slug":30714,"project_type":31,"team":30715,"organization":3565,"title":30716,"description":30717,"body":30718,"body_url":3565,"published":30719,"updated":30720,"approved":30721,"queued":30722,"status":29951,"requested_status":29951,"moderator_message":3565,"license":30723,"downloads":30724,"followers":29979,"categories":30725,"additional_categories":30726,"loaders":30727,"versions":30728,"icon_url":30730,"issues_url":30731,"source_url":30732,"wiki_url":3565,"discord_url":3565,"donation_urls":30733,"gallery":30734,"color":30735,"thread_id":30736,"monetization_status":30007},[1244],"kpbtykOA","vault-gui-upgrade","UOUyCstE","Vault GUI Upgrade","A client-side visual upgrade to some Vault Hunters tables","This is a client-side addon to the Vault Hunters modpack that adds an animation in the Card Essence Extractor GUI as well as rendering the card above the slot. This is simply a visual addon, it adds no functionality to the blocks it affects.\n\nMore is planned for this addon, including upgrades to the Black Market and Bounty Table GUIs\n\n_Art by Kumara22, Developed by attackeight for Millennium VHSMP_\n","2024-12-30T04:34:05.200224Z","2024-12-30T04:44:53.035510Z","2025-01-02T03:53:31.745808Z","2024-12-30T04:47:06.701764Z",{"id":30485,"name":30486,"url":3565},95,[],[],[354],[30729],"AEaGGsnC","https://cdn.modrinth.com/data/kpbtykOA/3c18e61cf865ef3b14754da767a39ddd0554b203.png","https://github.com/Attack8/VaultGuiUpgrade/issues","https://github.com/Attack8/VaultGuiUpgrade",[],[],11900226,"OPiwydjx",{"client_side":29964,"server_side":29963,"game_versions":30738,"id":30739,"slug":30740,"project_type":31,"team":30741,"organization":3565,"title":30742,"description":30743,"body":30744,"body_url":3565,"published":30745,"updated":30746,"approved":30747,"queued":30748,"status":29951,"requested_status":29951,"moderator_message":3565,"license":30749,"downloads":30753,"followers":30023,"categories":30754,"additional_categories":30755,"loaders":30756,"versions":30757,"icon_url":30770,"issues_url":30771,"source_url":30772,"wiki_url":30773,"discord_url":3565,"donation_urls":30774,"gallery":30780,"color":30781,"thread_id":30782,"monetization_status":30007},[1367,1349,1286,1271,1244,1187,1154,1145,1109,1070,1022,1016,983,941,935,863,857,820,814,766,763,733,685,643,634,628],"kqdGqP6X","obsidiancore","uVlicjOs","Obsidian","An API aimed to simplify the development of Bukkit plugins (please use Paper or any Paper fork)","# Obsidian\n\n\u003C!--suppress HtmlDeprecatedAttribute -->\n\u003Cp align=\"center\">\n    \u003Cimg src=\"https://raw.githubusercontent.com/Adrigamer2950/Obsidian/refs/heads/master/logo_256x.png\" alt=\"Logo\" />\n\u003C/p>\n\nAn API aimed to simplify the development of Paper plugins\n\n[![Available in Modrinth](https://raw.githubusercontent.com/intergrav/devins-badges/refs/heads/v3/assets/cozy/available/modrinth_vector.svg)](https://modrinth.com/plugin/obsidiancore)\n[![Available in HangarMC](https://raw.githubusercontent.com/intergrav/devins-badges/refs/heads/v3/assets/cozy/available/hangar_vector.svg)](https://hangar.papermc.io/devadri/Obsidian)\n\n# Info\n\nThis API is aimed to simplify the development of Paper plugins,\nproviding a lot of utilities that will make your life (and mine) easier\n\nEven though a standalone plugin version is available, it's recommended to shade this API into your\nplugins, as this API changes frequently and depending on the standalone version may cause\nsome issues if server owners install some plugins that depend on different versions of this API\n\n> ❗ You need Java 17+ to use this API/Plugin. If you are using a lower version consider upgrading\n\n> ⚠️ You need to set your plugin to use Spigot mappings in order to preserve compatibility with \n> Paper forks that are still using Spigot mappings.\n> More information in the [PaperMC documentation](https://docs.papermc.io/paper/dev/project-setup/#plugin-remapping)\n\n> ⚠️ Only Minecraft 1.17 or superior is officially supported. Versions below 1.17 will not receive any support\n\n### It's mostly used in my plugins, but you can use it on your own plugins if you want, just make sure to give proper credit!\n\n# How to import\n\n## Gradle\n\n````kotlin\nrepositories {\n    maven {\n        name = \"devadri\"\n        url = uri(\"https://repo.devadri.es/repository/releases\") // Use dev repository for beta builds\n    }\n}\n\ndependencies {\n    implementation(\"me.devadri:obsidian:{VERSION}\") // Replace {VERSION} with the desired version\n}\n````\n\n## Maven\n\n```xml\n\u003Crepositories>\n    \u003Crepository>\n        \u003Cid>devadri\u003C/id>\n        \u003Curl>https://repo.devadri.es/repository/releases\u003C/url> \u003C!-- Use dev repository for beta builds -->\n    \u003C/repository>\n\u003C/repositories>\n\n\u003Cdependencies>\n    \u003Cdependency>\n        \u003CgroupId>me.devadri\u003C/groupId>\n        \u003CartifactId>obsidian\u003C/artifactId>\n        \u003Cversion>{VERSION}\u003C/version> \u003C!-- Replace {VERSION} with the desired version -->\n    \u003C/dependency>\n\u003C/dependencies>\n```\n\n# Credits\n- Thanks to [Byteflux](https://github.com/Byteflux) and [AlessioDP](https://github.com/AlessioDP)\n  for creating the [Libby](https://github.com/AlessioDP/libby/tree/gradle) library, which is used to manage\n  dependencies at runtime.\n- Thanks to [CryptoMorin](https://github.com/CryptoMorin) for creating the [XSeries](https://github.com/CryptoMorin/XSeries) library,\n  which is used to preserve compatibility with older and newer versions of Minecraft, as IDs and APIs can vary\n  between versions.","2024-08-27T14:42:06.810952Z","2025-09-07T15:10:49.573410Z","2024-08-28T21:25:56.494718Z","2024-08-28T15:21:44.341424Z",{"id":30750,"name":30751,"url":30752},"GPL-3.0-or-later","GNU General Public License v3.0 or later","https://github.com/Adrigamer2950/AdriAPI/blob/master/LICENSE",302,[157],[],[329,350,401,405,417],[30758,30759,30760,30761,30762,30763,30764,30765,30766,30767,30768,30769],"vzGvqyLR","4BUomoAP","qYlK3eRx","DnDFupL7","XJQioiNi","LGilfyXe","mtEvcwNg","XPlNjBMo","6Tyh2lkV","yP10i3I3","dEAzZIj0","RFwvPCQF","https://cdn.modrinth.com/data/kqdGqP6X/08fc4301bc337e088ae77b05254b8dadaac1474b_96.webp","https://github.com/Adrigamer2950/AdriAPI/issues","https://github.com/Adrigamer2950/AdriAPI","https://docs.devadri.es",[30775,30778],{"id":3119,"platform":30776,"url":30777},"Github","https://github.com/sponsors/Adrigamer2950",{"id":3122,"platform":3123,"url":30779},"https://ko-fi.com/adrigamer2950",[],986647,"q88lAd7k",{"client_side":29963,"server_side":29964,"game_versions":30784,"id":30785,"slug":30786,"project_type":31,"team":30787,"organization":3565,"title":30788,"description":30789,"body":30790,"body_url":3565,"published":30791,"updated":30792,"approved":30793,"queued":30794,"status":29951,"requested_status":29951,"moderator_message":3565,"license":30795,"downloads":30796,"followers":29998,"categories":30797,"additional_categories":30798,"loaders":30799,"versions":30800,"icon_url":30802,"issues_url":3565,"source_url":3565,"wiki_url":3565,"discord_url":3565,"donation_urls":30803,"gallery":30806,"color":30819,"thread_id":30820,"monetization_status":30007},[532],"krhlpTc9","no-loading-screen","KAG3jZqg","No loading screen","Removes the annoying bright red Mojang loading screen completely. No compromises","# No loading screen (aka NoMojang)\nNoMojang removes the bright red Mojang startup splash screen in Minecraft and replaces it with a clean black loading screen.\n\n## What it does\nHides the red Mojang splash visuals\nKeeps normal game loading behavior intact\nShows a small status line in the center: Your game is starting\nShows credit text in the lower-left corner: Nomojang by grizzly dev\nWhy\nThe default startup splash can be too bright and distracting.\nThis mod keeps startup visually calm while preserving vanilla loading flow.\n\n## Compatibility\nMinecraft: 1.21.11\nLoader: Fabric\nEnvironment: Client-side\n## Notes\nSafe to use in modpacks\nNo config required","2026-03-22T12:32:49.653157Z","2026-03-25T09:11:01.680490Z","2026-03-23T00:08:17.340785Z","2026-03-22T12:43:46.218377Z",{"id":29977,"name":10,"url":3565},1847,[100,211,303],[],[346],[30801],"XEx47rau","https://cdn.modrinth.com/data/krhlpTc9/c8ba5758cd9e1fa7904cbd11cc2eba2f8477ec3a_96.webp",[30804],{"id":3116,"platform":30230,"url":30805},"https://www.paypal.com/donate/?hosted_button_id=4Z54S4FS2GR5Y",[30807,30813],{"url":30808,"raw_url":30809,"featured":822,"title":30810,"description":30811,"created":30812,"ordering":29998},"https://cdn.modrinth.com/data/krhlpTc9/images/5caf65fe33f4fefa6b2f7f68f82b8fc090838b5b_350.webp","https://cdn.modrinth.com/data/krhlpTc9/images/5caf65fe33f4fefa6b2f7f68f82b8fc090838b5b.png","After","Dark screen, not blinding, about 4x quicker to load","2026-03-22T12:43:02.796533Z",{"url":30814,"raw_url":30815,"featured":439,"title":30816,"description":30817,"created":30818,"ordering":29998},"https://cdn.modrinth.com/data/krhlpTc9/images/e83341410d18f8205d0a03a6d5c1af6ebd9ebaff_350.webp","https://cdn.modrinth.com/data/krhlpTc9/images/e83341410d18f8205d0a03a6d5c1af6ebd9ebaff.png","Before","Bright red, annoying, slow, useless animations, blinds at night\n\n","2026-03-22T12:42:49.884745Z",7802640,"Sn4pqFSi",{"client_side":29964,"server_side":29963,"game_versions":30822,"id":30823,"slug":30824,"project_type":31,"team":30825,"organization":3565,"title":30826,"description":30827,"body":30828,"body_url":3565,"published":30829,"updated":30830,"approved":30831,"queued":30832,"status":29951,"requested_status":29951,"moderator_message":3565,"license":30833,"downloads":30834,"followers":30465,"categories":30835,"additional_categories":30836,"loaders":30837,"versions":30838,"icon_url":30844,"issues_url":3565,"source_url":30845,"wiki_url":3565,"discord_url":3565,"donation_urls":30846,"gallery":30847,"color":30848,"thread_id":30849,"monetization_status":30007},[863,857,820,814,766,763,733,685,643,634,628,583,577,532],"kqq1adK8","simpleeconomy","JziyiUP9","SimpleEconomy","A simple and lightweight economy plugin","A simple and lightweight economy plugin with Vault and PlaceholderAPI support. Supports SQLite (default) and MySQL/MariaDB for data storage.\n\n# Commands\n- /bal [player] – Displays your current balance, or the balance of the specified player.\n- /baltop – Shows the top 10 richest players on the server.\n- /pay \u003Cplayer> \u003Camount> – Transfers the specified amount of money to another player.\n- /eco give \u003Cplayer> \u003Camount> – Adds money to a player's balance. (Permission: simpleeconomy.eco)\n- /eco take \u003Cplayer> \u003Camount> – Deducts money from a player's balance. (Permission: simpleeconomy.eco)\n- /eco set \u003Cplayer> \u003Camount> – Sets a player's balance. (Permission: simpleeconomy.eco)\n- /eco reset \u003Cplayer> – Resets a player's balance to the default. (Permission: simpleeconomy.eco)\n- /simpleeconomy reload – Reloads the plugin configuration. (Permission: simpleeconomy.se)\n\n# Placeholders (PlaceholderAPI)\n- %se_balance% – Returns the player's full balance with two decimal places.\n- %se_balance_formatted% – Returns the player's balance abbreviated (e.g., 1.5K, 2M, 3B).\n- %se_rank% – Returns the player's rank based on balance.\n- %se_total% – Returns the total economy balance (formatted).\n- %se_players% – Returns the total number of players with balances.","2025-05-21T07:10:12.759747Z","2026-02-17T13:38:59.161976Z","2025-05-25T10:06:17.205403Z","2025-05-21T07:23:13.244834Z",{"id":30750,"name":30751,"url":3565},635,[105],[],[401,405],[30839,30840,30841,30842,30843],"TI7gcIMX","d6PDLiLN","u4f5iV2e","cfzyBTcj","3Te9qLjq","https://cdn.modrinth.com/data/kqq1adK8/6fd4ecfec6bf5aa4bf0a401bd4a5e9c01310f289_96.webp","https://github.com/Improve1111/SimpleEconomy",[],[],2166532,"hsuvktIi",{"client_side":29963,"server_side":29963,"game_versions":30851,"id":30852,"slug":30853,"project_type":31,"team":30854,"organization":3565,"title":30855,"description":30856,"body":30857,"body_url":3565,"published":30858,"updated":30859,"approved":30860,"queued":30861,"status":29951,"requested_status":29951,"moderator_message":3565,"license":30862,"downloads":30864,"followers":29979,"categories":30865,"additional_categories":30866,"loaders":30867,"versions":30868,"icon_url":30871,"issues_url":30872,"source_url":30873,"wiki_url":3565,"discord_url":3565,"donation_urls":30874,"gallery":30875,"color":30880,"thread_id":30881,"monetization_status":30007},[1022,1016],"kprWzdPB","ediblepotions","nntH8iRQ","EdiblePotions","Infuse potion effects into food using a fully automatable Infusion Table.","# 🍎 Edible Potions\n\n**Edible Potions** brings a new layer of strategy to Minecraft survival by allowing you to infuse food with potion effects. Stop wasting time drinking potions during intense battles—just take a bite and get the buff instantly!\n\n![Banner Image](https://i.imgur.com/7YSttFa.png)\n\n## ✨ Main Features\n\n* **🧪 The Infusion Table:** A brand new workstation designed to combine food and potions. It fits perfectly into the vanilla aesthetic.\n* **⚡ Instant Effects:** Infused food applies potion effects immediately upon consumption. No more slow drinking animations!\n* **⚖️ Balanced Gameplay:** The Infusion Table is crafted with mid-to-late game materials (Gold, Diamond, Obsidian) to ensure balance.\n* **⚙️ Full Automation:** Designed for technical players! The Infusion Table is fully compatible with Hoppers and pipes.\n* **🌐 Cross-Platform:** One mod, two loaders. Works seamlessly on both **Forge** and **Fabric** (Minecraft 1.20.1).\n\n---\n\n## 🛠️ Automation Guide\n\nThe Infusion Table is a **WorldlyContainer**, meaning it interacts with automation blocks logically:\n\n* **Top Face (⬆️):** Input **Food** (e.g., Apple, Bread, Beef).\n* **Side Faces (⬅️➡️):** Input **Potions** (e.g., Potion of Night Vision).\n* **Bottom Face (⬇️):** Extract **Infused Food** and **Empty Glass Bottles**.\n\nThis allows you to build a fully automatic factory that turns raw food and brewed potions into powerful edible buffs!\n\n---\n\n## 📦 Installation\n\nThis mod uses **Architectury API** to run on multiple platforms.\n\n* **For Fabric:**\n    * Install [Fabric API](https://www.curseforge.com/minecraft/mc-mods/fabric-api)\n    * Install [Architectury API](https://www.curseforge.com/minecraft/mc-mods/architectury-api)\n* **For Forge:**\n    * Install [Architectury API](https://www.curseforge.com/minecraft/mc-mods/architectury-api)\n\n---\n\n## 🇨🇳 中文介绍 (Chinese Description)\n\n**食用药剂 (Edible Potions)** 是一个轻量级且功能强大的模组，允许你将药水效果“注入”到食物中。告别战斗中繁琐的喝药动作——吃下一颗苹果，瞬间获得夜视或力量效果！\n\n### ✨ 主要功能\n\n* **注能台 (Infusion Table):** 全新的工作台，用于制作注能食物，完美融入原版画风。\n* **瞬间生效:** 食用注能食物后立即获得药水效果，无需等待喝药动画。\n* **自动化支持:** 专为红石和生电玩家设计！\n    * **上方输入:** 食物\n    * **侧面输入:** 药水\n    * **下方输出:** 成品 & 空瓶子\n* **双端支持:** 同时支持 **Forge** 和 **Fabric** (1.20.1)。\n\n### 🧩 依赖项\n\n本模组需要 **Architectury API** 作为前置。\n* **Fabric 用户:** 请同时安装 Fabric API 和 Architectury API。\n* **Forge 用户:** 仅需安装 Architectury API。","2026-01-12T15:41:54.679517Z","2026-01-12T15:47:36.777444Z","2026-01-17T23:14:28.512754Z","2026-01-12T15:51:32.826090Z",{"id":30020,"name":30021,"url":30863},"https://github.com/lingyunmo/EdiblePotionsMod?tab=GPL-3.0-1-ov-file",80,[131,171],[],[346,354],[30869,30870],"aNZsfIgI","1x08p5CO","https://cdn.modrinth.com/data/kprWzdPB/690c39284aeaebbff1058b76dc435245bfb9d41a_96.webp","https://github.com/lingyunmo/EdiblePotionsMod/issues","https://github.com/lingyunmo/EdiblePotionsMod",[],[30876],{"url":30877,"raw_url":30878,"featured":439,"title":3565,"description":3565,"created":30879,"ordering":29998},"https://cdn.modrinth.com/data/kprWzdPB/images/29216c8499fc1b5e39efe35d45a60f139a4c1002_350.webp","https://cdn.modrinth.com/data/kprWzdPB/images/29216c8499fc1b5e39efe35d45a60f139a4c1002.png","2026-01-12T15:50:35.539816Z",5966424,"bN5CPz8s",{"client_side":29963,"server_side":29964,"game_versions":30883,"id":30884,"slug":30885,"project_type":12,"team":30886,"organization":3565,"title":30887,"description":30888,"body":30889,"body_url":3565,"published":30890,"updated":30891,"approved":30892,"queued":30893,"status":29951,"requested_status":29951,"moderator_message":3565,"license":30894,"downloads":30895,"followers":30896,"categories":30897,"additional_categories":30898,"loaders":30899,"versions":30900,"icon_url":30903,"issues_url":3565,"source_url":3565,"wiki_url":3565,"discord_url":3565,"donation_urls":30904,"gallery":30905,"color":30961,"thread_id":30962,"monetization_status":30007},[814,733,685,643],"krkd4rk0","enderscape-more-emissives","RFiuuLNX","Enderscape More Emissives","Additional emissive textures for Enderscape, a remake of Lum for updated Enderscape.","Additional emissive textures for [Enderscape](https://modrinth.com/mod/enderscape).\n\nAfter seeing [Enderscape](https://modrinth.com/mod/enderscape) updated to 1.21+ I remembered an old popular resource pack named [Lum](https://www.curseforge.com/minecraft/texture-packs/lum). But it didn't get any update so I wanted to remake it. You can find images about resource pack in [gallery](https://modrinth.com/resourcepack/enderscape-more-emissives/gallery). I hope y'all enjoy it.\n\nThis resource pack requires [Enderscape](https://modrinth.com/mod/enderscape)(obviously), [Continuity](https://modrinth.com/mod/continuity) and [[ETF] Entity Texture Features](https://modrinth.com/mod/entitytexturefeatures).\n\nThanks Lunarbunten for the mod and updating it!","2025-05-17T15:52:16.455940Z","2025-05-23T05:56:25.175518Z","2025-05-20T08:36:34.687053Z","2025-05-17T16:46:08.647474Z",{"id":30132,"name":30133,"url":3565},1050,7,[100,194,300],[15,57,110,113,303],[377],[30901,30902],"zTDvwUe8","JQEgZjCi","https://cdn.modrinth.com/data/krkd4rk0/cbe408e5631a5839f86d76a41ab1dc6a73f41e2d.png",[],[30906,30911,30916,30921,30926,30931,30936,30941,30946,30951,30956],{"url":30907,"raw_url":30908,"featured":439,"title":30909,"description":3565,"created":30910,"ordering":29998},"https://cdn.modrinth.com/data/krkd4rk0/images/19752a8292f6e5f3d7506afd72a7de07b7413c29_350.webp","https://cdn.modrinth.com/data/krkd4rk0/images/19752a8292f6e5f3